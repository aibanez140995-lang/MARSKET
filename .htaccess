# ==============================================================================
# MARS-KET OS - Configuración Apache (.htaccess) para Hosting CDMON
# Servidor: Apache 2.4+ / PHP 8.x
# Versión: v1.1.51
# ==============================================================================

# EXENCIÓN LOADER.IO PARA VALIDACIÓN DE ESTRÉS
<Files "loaderio-e04fe1e017d5e583689533102b7d015a.txt">
    Order Allow,Deny
    Allow from all
    Satisfy Any
    Require all granted
</Files>
<Files "loaderio-e04fe1e017d5e583689533102b7d015a.html">
    Order Allow,Deny
    Allow from all
    Satisfy Any
    Require all granted
</Files>

# 1. ENRUTAMIENTO API Y BLOQUEO DE ARCHIVOS SENSIBLES (mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloqueo estricto incondicional de base de datos y archivos sensibles (HTTP 403)
    RewriteRule ^data(/.*)?$ - [F,L]
    RewriteRule \.(sqlite|sqlite3|db|env|sql|bak|log)$ - [F,L]

    # Pasar cabecera Authorization a PHP (imprescindible en entornos FastCGI / PHP-FPM de CDMON)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirigir todas las llamadas /api/* hacia api/index.php preservando query string
    RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]
</IfModule>

# 2. SEGURIDAD: PROTECCIÓN DE DIRECTORIOS Y ARCHIVOS SENSIBLES
# Denegar acceso directo a directorios críticos y archivos de base de datos / logs / repositorios
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <FilesMatch "(^\.|\.sqlite$|\.sqlite3$|\.db$|\.env$|\.log$|\.sql$|\.bak$|\.md$|package\.json|wrangler\.toml)">
        Require all denied
    </FilesMatch>
    <FilesMatch "^loaderio-.*">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2 legacy fallback
    <FilesMatch "(^\.|\.sqlite$|\.sqlite3$|\.db$|\.env$|\.log$|\.sql$|\.bak$|\.md$|package\.json|wrangler\.toml)">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^loaderio-.*">
        Order allow,deny
        Allow from all
        Satisfy Any
    </FilesMatch>
</IfModule>

# Deshabilitar listado de directorios (comentado por compatibilidad AllowOverride CDMON)
# Options -Indexes

# 3. RENDIMIENTO: COMPRESIÓN GZIP / DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# 4. RENDIMIENTO: CABECERAS DE CACHÉ PARA ASSETS ESTÁTICOS
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y JSON: Validación inmediata sin caché obsoleta
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # Estáticos versionados (CSS, JS, Imágenes, Favicons)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cabeceras de Seguridad, Aislamiento HTTP Hermético y Supresión de CDNs (WP2)
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"

    # Prevenir almacenamiento en caché estática pero permitir validación ETag / HTTP 304 en la API
    <FilesMatch "index\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Service Worker y Manifest: validación estricta sin caché HTTP para actualizaciones inmediatas
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
